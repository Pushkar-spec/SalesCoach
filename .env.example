# Real-Time AI Sales Copilot - Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real API keys or credentials to version control.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# WebSocket Configuration
BACKEND_WS_URL=ws://127.0.0.1:8000/ws

# Speech-to-Text (STT) Configuration (Step 3.2B)
# Supported models: tiny.en, base.en, small.en, medium.en
WHISPER_MODEL_NAME=base.en
# Acceleration device: cuda (recommended) or cpu
WHISPER_DEVICE=cuda
# Model replica pool (concurrency isolation)
WHISPER_MODEL_REPLICAS=1
WHISPER_TRANSCRIBE_WORKERS=4
# Bounded queue capacity (number of 250ms chunks before backpressure)
WHISPER_QUEUE_MAXSIZE=200
# Silence endpointing and lead-in trimming
WHISPER_SILENCE_THRESHOLD=500
WHISPER_SILENCE_MS=1500.0
# Committed prefix streaming parameters
WHISPER_COMMIT_PREFIX=1
WHISPER_COMMIT_AFTER_MS=4000.0
WHISPER_COMMIT_MARGIN_MS=1000.0

# Planned Services (Placeholders only - not required for Step 3.2B)
# OPENAI_API_KEY=your_openai_api_key_here
